<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invitación</title>
</head>

<body style="text-align:center; background:#fff;">

    <!-- Imagen de la invitación -->
    <img 
        src="https://i.ibb.co/yBb6Zmx3/Whats-App-Image-2026-05-13-at-10-13-55-PM.jpg" 
        alt="Invitación"
        style="max-width:100%; height:auto;"
    >

    <!-- Botón o enlace de ubicación -->
    <div style="margin-top:20px;">
        <a 
            href="https://goo.gl/maps/Q1VLdMZTBwJyq6pm6"
            target="_blank"
            style="
                background-color:#d4af37;
                color:white;
                padding:12px 25px;
                text-decoration:none;
                border-radius:10px;
                font-size:20px;
            "
        >
            Ver ubicación
        </a>
    </div>

</body>
</html>
